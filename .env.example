# Fulcrum Ops control plane
FULCRUM_BASE_URL=https://controlplane.fdprod.net
FULCRUM_EMAIL=you@company.com
FULCRUM_PASSWORD=

# Optional: agents are meant to authenticate with a workspace API key rather
# than an operator password. Set this and the email/password become unused.
# FULCRUM_API_KEY=fo_live_...

# Optional: pin a workspace when the account belongs to more than one.
# FULCRUM_WORKSPACE=fulcrum-digital

# Local model for the self-learning loop (nothing leaves the machine).
#   brew install ollama && ollama serve && ollama pull qwen2.5-coder:3b
# OLLAMA_HOST=http://127.0.0.1:11434
# FULCRUM_LLM_MODEL=qwen2.5-coder:3b
